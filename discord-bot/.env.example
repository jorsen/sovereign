# Discord bot token from https://discord.com/developers/applications (Bot tab).
DISCORD_TOKEN=

# Application ID from the same Developer Portal page (General Information
# tab, "Application ID") -- required only to run register-commands.js.
DISCORD_CLIENT_ID=

# Optional: your server's ID (right-click the server icon > Copy Server ID,
# with Developer Mode on). If set, register-commands.js registers /growth
# just for this server (shows up instantly). If left blank, it registers
# globally instead (can take up to an hour to appear).
DISCORD_GUILD_ID=

# The growth-rate submission channel. Defaults to the one already given, but
# override if you ever move the channel.
DISCORD_CHANNEL_ID=1547642467728236706

# Base URL of the deployed Sovereign app (no trailing slash).
SOVEREIGN_API_BASE=https://your-app.vercel.app

# Must match GROWTH_BOT_SECRET set in the Sovereign app's own environment
# variables (Vercel project settings) -- this is what proves a request to
# POST /api/growth-submissions/bot actually came from this bot.
GROWTH_BOT_SECRET=
